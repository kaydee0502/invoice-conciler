{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Match output: invoice lines -> shipments",
  "type": "object",
  "required": ["_session_id", "stage", "line_count", "lines", "unbilled_shipments", "shipments_billed_more_than_once"],
  "properties": {
    "_session_id": { "type": "string", "minLength": 1 },
    "stage": { "const": "match" },
    "line_count": { "type": "integer", "minimum": 1 },
    "lines": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["line_key", "shipment_id", "match", "fact_conflicts", "hints", "corrects_line_keys"],
        "properties": {
          "shipment_id": { "type": ["string", "null"] },
          "match": { "enum": ["exact_ref", "ambiguous_ref", "unmatched"] },
          "fact_conflicts": { "type": "array", "items": { "type": "object", "required": ["fact", "invoice", "shipment", "materiality"],
            "properties": { "materiality": { "enum": ["pricing", "informational"] } } } },
          "hints": { "type": "array", "items": { "type": "object", "required": ["kind", "detail"] } }
        }
      }
    }
  }
}
