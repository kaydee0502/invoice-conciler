{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rate-spec completeness check",
  "type": "object",
  "required": ["_session_id", "stage", "carriers", "rate_specs"],
  "properties": {
    "_session_id": { "type": "string", "minLength": 1 },
    "stage": { "const": "check_specs" },
    "carriers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rate_specs": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
  }
}
