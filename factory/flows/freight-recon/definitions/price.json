{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Price output: expected amounts and provisional dispositions",
  "type": "object",
  "required": ["_session_id", "stage", "line_count", "lines", "invoice_findings", "rules"],
  "properties": {
    "_session_id": { "type": "string", "minLength": 1 },
    "stage": { "const": "price" },
    "lines": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["line_key", "invoice", "consignment_ref", "shipment_id", "billed_amount", "expected_amount",
                     "delta", "disposition", "rule", "review", "reasons", "justification", "contract_clause"],
        "properties": {
          "disposition": { "enum": ["accept", "dispute", "escalate"] },
          "rule": { "type": "string", "pattern": "^R_[A-Z_]+$" },
          "justification": { "type": "string", "minLength": 1 },
          "expected_amount": { "type": ["number", "null"] },
          "delta": { "type": ["number", "null"] },
          "review": { "type": "boolean" }
        }
      }
    },
    "invoice_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["invoice", "kind", "description", "amount_impact", "disposition", "rule", "justification"],
        "properties": { "disposition": { "enum": ["accept", "dispute", "escalate"] } } }
    }
  }
}
